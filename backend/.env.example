DATABASE_URL=postgresql://vitta:vitta@localhost:5432/vitta
PORT=3000

# Segredo que assina os tokens JWT. Em producao use um valor longo e aleatorio (32+ caracteres).
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Quanto tempo o token vale (ex.: 7d, 12h).
JWT_EXPIRES_IN=7d

# Sites que podem chamar a API pelo navegador (a versão web do app), separados por vírgula. "*" libera todos.
# Deixe em branco se você só usa o app no celular.
# CORS_ORIGENS=https://vitta-app-ucb.onrender.com

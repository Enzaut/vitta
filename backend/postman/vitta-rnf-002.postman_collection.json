{
  "info": {
    "name": "VITTA - RNF-002 Controle de acesso (E2-3)",
    "description": "Cenário da matriz de verificação: com o token do doador A, chamar as rotas de perfil, formulário e exclusão usando o id do doador B. Resultado esperado: erro 403 (ou 404) em todas, sem vazar dados, e a conta e o formulário de B continuam intactos.\n\nComo usar: suba a API (npm run dev na pasta backend) e rode a coleção inteira (Collection Runner do Postman ou `npx newman run`). Para outro ambiente, mude a variável baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "1. Cadastrar o doador A",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"emailA\", \"a.\" + Date.now() + \"@teste.vitta\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Cadastro de A: 201\", function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set(\"tokenA\", json.token);",
              "pm.collectionVariables.set(\"idA\", json.doador.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Doador A\",\n  \"email\": \"{{emailA}}\",\n  \"dataNascimento\": \"1995-03-15\",\n  \"senha\": \"Senha@2026\",\n  \"confirmarSenha\": \"Senha@2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/cadastro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "cadastro"
          ]
        },
        "description": "Cria a conta A e guarda o token e o id dela nas variáveis da coleção."
      }
    },
    {
      "name": "2. Cadastrar o doador B",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"emailB\", \"b.\" + Date.now() + \"@teste.vitta\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Cadastro de B: 201\", function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set(\"tokenB\", json.token);",
              "pm.collectionVariables.set(\"idB\", json.doador.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Doador B\",\n  \"email\": \"{{emailB}}\",\n  \"dataNascimento\": \"1990-07-20\",\n  \"senha\": \"Senha@2026\",\n  \"confirmarSenha\": \"Senha@2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/cadastro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "cadastro"
          ]
        },
        "description": "Cria a conta B e guarda o token e o id dela."
      }
    },
    {
      "name": "3. B informa telefone e tipo sanguíneo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"B salvou os dados: 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenB}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"telefone\": \"11988887777\",\n  \"tipoSanguineo\": \"O-\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/doadores/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "doadores",
            "me"
          ]
        },
        "description": "Dá a B dados que dá para notar se alguém mexer."
      }
    },
    {
      "name": "4. B responde ao formulário de elegibilidade (POST /doadores/me/formulario)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Formulário de B enviado: 201\", function () { pm.response.to.have.status(201); });",
              "const f = pm.response.json().formulario;",
              "pm.test(\"Resultado de B: INAPTO (peso abaixo de 50 kg)\", function () { pm.expect(f.resultado).to.eql(\"INAPTO\"); });",
              "pm.collectionVariables.set(\"preenchidoEmB\", f.preenchidoEm);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenB}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"respostas\": {\n    \"bemHoje\": true,\n    \"gripe\": false,\n    \"sinaisAlerta\": false,\n    \"peso\": 49,\n    \"sexo\": \"F\",\n    \"jaDoou\": false,\n    \"procedimentos\": {},\n    \"piercingBocaGenital\": \"nao\",\n    \"remedios\": {},\n    \"vacinas\": {},\n    \"cirurgias\": {},\n    \"dentista\": {},\n    \"transfusao\": false,\n    \"condicoes\": {},\n    \"ist\": false,\n    \"riscoSexual\": {},\n    \"drogas\": {},\n    \"malaria\": false,\n    \"gestacao\": {},\n    \"declaracao\": true\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/doadores/me/formulario",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "doadores",
            "me",
            "formulario"
          ]
        },
        "description": "B responde ao formulário da HU-03 com 49 kg. Esperado: 201 e resultado INAPTO (por peso)."
      }
    },
    {
      "name": "5. A vê o próprio perfil (GET /doadores/me)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"A vê o próprio perfil: 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"É mesmo o perfil de A\", function () { pm.expect(pm.response.json().doador.id).to.eql(pm.collectionVariables.get(\"idA\")); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/doadores/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "doadores",
            "me"
          ]
        },
        "description": "Controle: com o próprio token, A acessa os próprios dados."
      }
    },
    {
      "name": "6. A tenta VER o perfil de B (GET /doadores/{idB})",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"A tentativa de ver o perfil de B é recusada (403 ou 404)\", function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([403, 404]);",
              "});",
              "pm.test(\"A resposta não mostra nenhum dado de B\", function () {",
              "  const texto = pm.response.text();",
              "  pm.expect(texto).to.not.include(pm.collectionVariables.get(\"emailB\"));",
              "  pm.expect(texto).to.not.include(\"Doador B\");",
              "  pm.expect(texto).to.not.include(\"11988887777\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/doadores/{{idB}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "doadores",
            "{{idB}}"
          ]
        },
        "description": "Com o token de A, usa o id de B no caminho. Esperado: 403 (ou 404)."
      }
    },
    {
      "name": "7. A tenta ALTERAR o perfil de B (PATCH /doadores/{idB})",
      "event": [
        {
          "listen": "test",
          "script": {

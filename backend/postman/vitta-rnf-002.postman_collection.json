            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/doadores/{{idB}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "doadores",
            "{{idB}}"
          ]
        },
        "description": "Com o token de A, tenta mudar o telefone e o tipo sanguíneo de B. Esperado: 403 (ou 404)."
      }
    },
